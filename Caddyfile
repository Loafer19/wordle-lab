# Container web server (see Dockerfile), listening on :80 behind the Dokploy proxy
:80 {
	root * /srv

	# Hashed build assets never change; everything else (index.html, SPA routes, /sim and /ua data, icons) revalidates via ETag
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /assets/*
	header @mutable Cache-Control "no-cache"

	# On-the-fly compression for anything without a precompressed sidecar (files under 1 kB, images, zstd-only clients)
	encode zstd gzip

	try_files {path} /index.html
	# Serve the .br/.gz files emitted at build time by vite-plugin-compression2 (brotli q11, gzip -9)
	file_server {
		precompressed br gzip
	}
}
